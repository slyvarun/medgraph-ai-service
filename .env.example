# ==============================================================================
# MedGraph Nexus - Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# Neo4j AuraDB Cloud Connection
NEO4J_URI=neo4j+s://your-subdomain.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Google Gemini API Key for Clinical GraphRAG
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenFDA API Key for High-Throughput Ingestion (Standard rate limit applies without key)
OPENFDA_API_KEY=your_openfda_key_here
